+// ---------------------------------------------------------------------------
+// Fast path for 1D im2col (is_2D == false): [N, IC, IW] -> [N, OW, IC*KW]
+//   dst[in, iow, iic*KW + ikw] = x[in, iic, iow*s0 + ikw*d0 - p0]  (0 if OOB)
+// The generic im2col_kernel above has a strided read (iic is the fast index,
+// so each warp touches IC channels IW apart) and only a few blocks in grid.x,
+// which makes it ~100x slower than bandwidth-bound for the huge OW used by the
+// audio codec. This kernel tiles OW into shared memory so both the x loads and
+// the dst stores are coalesced.
+// ---------------------------------------------------------------------------
+#define IM2COL_1D_TILE_OW 32
+#define IM2COL_1D_TILE_IC 32
+
+template <typename T>
+static __global__ void im2col_1d_kernel(
+        const float * __restrict__ x, T * __restrict__ dst,
+        const int64_t IC, const int64_t IW, const int64_t OW, const int64_t KW,
+        const int64_t ic_stride, const int64_t batch_stride,
+        const int s0, const int p0, const int d0) {
+    extern __shared__ float smem[]; // [IM2COL_1D_TILE_IC][TILE_IW]
+
+    const int TILE_IW = IM2COL_1D_TILE_OW * s0 + (int)(KW - 1) * d0;
+
+    const int64_t ow0 = (int64_t)blockIdx.x * IM2COL_1D_TILE_OW;
+    const int64_t ic0 = (int64_t)blockIdx.y * IM2COL_1D_TILE_IC;
+    const int64_t in  = blockIdx.z;
+    const int64_t iw0 = ow0 * s0 - p0;
+
+    const int t = threadIdx.x;
+
+    // Load the input tile into shared memory (coalesced over the innermost iw).
+    const int load_total = IM2COL_1D_TILE_IC * TILE_IW;
+    for (int idx = t; idx < load_total; idx += blockDim.x) {
+        const int il  = idx / TILE_IW;
+        const int iwl = idx - il * TILE_IW;
+        const int64_t ic = ic0 + il;
+        const int64_t iw = iw0 + iwl;
+        smem[idx] = (ic < IC && iw >= 0 && iw < IW)
+                      ? x[in * batch_stride + ic * ic_stride + iw]
+                      : 0.0f;
+    }
+    __syncthreads();
+
+    // Write the output tile (coalesced over the innermost (iic, ikw)).
+    const int64_t write_total = (int64_t)IM2COL_1D_TILE_OW * IM2COL_1D_TILE_IC * KW;
+    for (int64_t idx = t; idx < write_total; idx += blockDim.x) {
+        const int64_t ow_local = idx / ((int64_t)IM2COL_1D_TILE_IC * KW);
+        const int64_t rem      = idx - ow_local * ((int64_t)IM2COL_1D_TILE_IC * KW);
+        const int     ic_local = (int)(rem / KW);
+        const int     ikw      = (int)(rem - ic_local * KW);
+
+        const int64_t iow = ow0 + ow_local;
+        const int64_t iic = ic0 + ic_local;
+        if (iow >= OW || iic >= IC) {
+            continue;
+        }
+        const int iwl = (int)ow_local * s0 + ikw * d0;
+        dst[in * (OW * IC * KW) + iow * (IC * KW) + iic * KW + ikw] = (T)smem[ic_local * TILE_IW + iwl];
+    }
+}
+
+static bool im2col_1d_use_fast(int64_t IC, int64_t KW, int64_t N, int s0, int p0, int d0) {
+    if (N >= 65536) {
+        return false;
+    }
+    const int TILE_IW = IM2COL_1D_TILE_OW * s0 + (int)(KW - 1) * d0;
+    if (TILE_IW <= 0) {
+        return false;
+    }
+    const int64_t smem_floats = IM2COL_1D_TILE_IC * TILE_IW;
+    // Keep the shared-memory tile under ~48 KB.
+    if (smem_floats > 12000) {
+        return false;
+    }
+    (void)IC;
+    return true;
+}
+
+template <typename T>
+static void im2col_1d_cuda(const float * x, T * dst,
+    int64_t IC, int64_t IW, int64_t OW, int64_t KW, int64_t N,
+    int64_t ic_stride, int64_t batch_stride,
+    int s0, int p0, int d0, cudaStream_t stream) {
+    const int TILE_IW = IM2COL_1D_TILE_OW * s0 + (int)(KW - 1) * d0;
+    const int smem_bytes = IM2COL_1D_TILE_IC * TILE_IW * (int)sizeof(float);
+    dim3 grid((unsigned)((OW + IM2COL_1D_TILE_OW - 1) / IM2COL_1D_TILE_OW),
+              (unsigned)((IC + IM2COL_1D_TILE_IC - 1) / IM2COL_1D_TILE_IC),
+              (unsigned)N);
+    im2col_1d_kernel<T><<<grid, 256, smem_bytes, stream>>>(x, dst, IC, IW, OW, KW, ic_stride, batch_stride, s0, p0, d0);
+}
